CREATE USER IF NOT EXISTS CICD_GITHUB_USER
    TYPE = SERVICE
    DEFAULT_ROLE = CICD_DEPLOY_ROLE
    DEFAULT_WAREHOUSE = CICD_WH
    DEFAULT_NAMESPACE = 'CICD_DEMO_DB.CICD_SCHEMA'
    COMMENT = 'Service user for Snowflake CI/CD GitHub Actions';


 GRANT ROLE CICD_DEPLOY_ROLE
TO USER CICD_GITHUB_USER;  


