CREATE DATABASE CICD_DEMO_DB;

show databases like 'CICD_DEMO_DB';

CREATE WAREHOUSE CICD_WH
WAREHOUSE_SIZE = 'XSMALL'
AUTO_SUSPEND = 60
AUTO_RESUME = TRUE
INITIALLY_SUSPENDED = TRUE;

SHOW WAREHOUSES LIKE 'CICD_WH';

CREATE SCHEMA IF NOT EXISTS CICD_DEMO_DB.PUBLIC;

SELECT
    CURRENT_DATABASE(),
    CURRENT_SCHEMA();

SELECT
    CURRENT_USER() AS USER_NAME,
    CURRENT_ROLE() AS CURRENT_ROLE,
    CURRENT_WAREHOUSE() AS CURRENT_WAREHOUSE,
    CURRENT_DATABASE() AS CURRENT_DATABASE,
    CURRENT_SCHEMA() AS CURRENT_SCHEMA;

   CREATE ROLE IF NOT EXISTS CICD_DEPLOY_ROLE; 

GRANT USAGE ON WAREHOUSE CICD_WH
TO ROLE CICD_DEPLOY_ROLE;  

SHOW GRANTS TO ROLE CICD_DEPLOY_ROLE;

GRANT USAGE ON DATABASE CICD_DEMO_DB
TO ROLE CICD_DEPLOY_ROLE;

CREATE SCHEMA IF NOT EXISTS CICD_DEMO_DB.CICD_SCHEMA
COMMENT = 'Development schema for Snowflake CI/CD project';

SHOW SCHEMAS IN DATABASE CICD_DEMO_DB;

